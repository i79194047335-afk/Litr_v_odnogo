[Unit]
Description=Lighter participant-mining collector (trade tape with account fields)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/projects/Litr_v_odnogo
# Markets 0 (ETH), 1 (BTC), 2 (SOL), 24 (HYPE). Market 1 came first — it is what
# the backtest track used and it carries ~2/3 of the tape volume — and the rest
# were added once the collector had proven itself. HYPE earns its place by being
# unlike the others: its liquidation rate ran 0.686% of trades on Jul 29 against
# BTC's 0.018%. Add ids here to widen.
ExecStart=/root/projects/Litr_v_odnogo/.venv/bin/python -m src.collector.lighter_participants --markets 0 1 2 24
Restart=always
RestartSec=5
# The collector handles SIGTERM itself: it cancels the reader, flushes the gzip
# buffer and exits 0. Without a clean stop the tail of the buffer is lost on
# every redeploy, so give it room rather than killing it.
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=append:/var/log/lighter-participants.log
StandardError=append:/var/log/lighter-participants.log

[Install]
WantedBy=multi-user.target
